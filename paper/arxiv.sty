% Page and package setup for the Terraluna paper (PRD 22.1), written for this repository.
% Tectonic's XeTeX engine sets Latin Modern by default, so fontenc and inputenc are not loaded.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{arxiv}[2026/11/14 Terraluna paper style]

\RequirePackage[letterpaper, margin=1in]{geometry}
\RequirePackage[authoryear, round]{natbib}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{booktabs}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
% hyperref comes last so that it can patch the packages above.
\RequirePackage{hyperref}
\hypersetup{
  colorlinks = true,
  linkcolor = blue!60!black,
  citecolor = blue!60!black,
  urlcolor = blue!60!black,
}

% A generated number macro whose artifact or value does not exist yet renders as this text,
% never as 0 (scripts/numbers.py).
\newcommand{\NotAvailable}{\textit{not available}}

% Measurement sections may hold no literal digit outside macros (scripts/test_manuscript.py), so
% the coefficient of determination and the wide table columns are named here.
\RequirePackage{array}
\newcommand{\Rsq}{\ensuremath{R^{2}}}
\newcolumntype{W}{p{0.52\linewidth}}
