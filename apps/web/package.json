{
  "name": "@terraluna/web",
  "version": "0.0.0",
  "private": true,
  "description": "Terraluna web app: Next.js App Router pages rendered from the release bundle (PRD 8.3, 8.6).",
  "type": "module",
  "scripts": {
    "bundle:pull": "node scripts/bundle-pull.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "smoke": "node scripts/smoke.ts",
    "probe:bench": "node scripts/probe-bench.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p server/api",
    "test": "vitest run",
    "e2e:install": "playwright install chromium",
    "e2e": "node scripts/bundle-pull.ts && next build && playwright test",
    "test:parity": "vitest run --config vitest.parity.config.ts"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.1",
    "@deck.gl/geo-layers": "9.4.1",
    "@deck.gl/layers": "9.4.1",
    "@deck.gl/react": "9.4.1",
    "@hono/zod-openapi": "1.6.3",
    "@observablehq/plot": "0.6.19",
    "@radix-ui/react-slot": "1.5.0",
    "@scalar/hono-api-reference": "0.12.20",
    "@terraluna/core": "workspace:*",
    "@terraluna/schema": "workspace:*",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "geotiff": "3.0.5",
    "hono": "4.13.18",
    "next": "16.4.6",
    "onnxruntime-web": "1.31.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@seriousme/openapi-schema-validator": "2.12.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "parse5": "8.0.1",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
