# `vercel deploy` from the repository root uploads the working tree. Leave out what .gitignore
# keeps local (caches, pulled bundle data, .env files), so a CLI deployment
# builds from the same files as a Git deployment. Vercel itself skips .git, node_modules, .next,
# .vercel, .venv and __pycache__.
.env
.env.*
!.env.example

.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
*.py[cod]
.turbo/
dist/
coverage/
*.tsbuildinfo
playwright-report/
test-results/
.DS_Store
/.vscode/
/.husky/_/

/data/
/apps/web/data/
/apps/web/next-env.d.ts
/ml/checkpoints/
/ml/shards/
/wandb/
/reference-library/repositories/
/logs/agents/**/raw/
/paper/*.pdf
