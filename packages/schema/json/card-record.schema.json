{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CampaignEntry": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "source": {
                "type": "string"
              }
            }
          },
          "if": {
            "properties": {
              "value": {
                "const": "unknown"
              }
            },
            "required": [
              "value"
            ]
          },
          "then": {
            "properties": {
              "source": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "A campaign answer (question 6): ``unknown`` exactly when it has no source.",
      "properties": {
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source"
        }
      },
      "required": [
        "value",
        "source"
      ],
      "title": "CampaignEntry",
      "type": "object"
    },
    "CardCampaign": {
      "additionalProperties": false,
      "description": "Question 6: the practical campaign questions.",
      "properties": {
        "access": {
          "$ref": "#/$defs/CampaignEntry"
        },
        "permits": {
          "$ref": "#/$defs/CampaignEntry"
        },
        "season": {
          "$ref": "#/$defs/CampaignEntry"
        },
        "land_status": {
          "$ref": "#/$defs/CampaignEntry"
        },
        "logistics": {
          "$ref": "#/$defs/CampaignEntry"
        }
      },
      "required": [
        "access",
        "permits",
        "season",
        "land_status",
        "logistics"
      ],
      "title": "CardCampaign",
      "type": "object"
    },
    "CardDifferences": {
      "additionalProperties": false,
      "description": "Question 4. ``limits`` holds Earth's seven limits, or the Mars list, of PRD 10 as the\ncard writer supplies them; the schema fixes neither the wording nor the count.",
      "properties": {
        "limits": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Limits",
          "type": "array"
        },
        "differing": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Differing",
          "type": "array"
        },
        "ambiguous": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Ambiguous",
          "type": "array"
        },
        "not_observed": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Not Observed",
          "type": "array"
        }
      },
      "required": [
        "limits",
        "differing",
        "ambiguous",
        "not_observed"
      ],
      "title": "CardDifferences",
      "type": "object"
    },
    "CardEarth": {
      "additionalProperties": false,
      "description": "The Earth window the card compares (question 1).",
      "properties": {
        "earth_window_id": {
          "pattern": "^(moon|mars|earth)-[a-z0-9][a-z0-9-]*$",
          "title": "Earth Window Id",
          "type": "string"
        },
        "polygon": {
          "$ref": "#/$defs/WindowPolygon"
        },
        "product_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Product Ids",
          "type": "array"
        },
        "search_region_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Search Region Id"
        }
      },
      "required": [
        "earth_window_id",
        "polygon",
        "product_ids",
        "search_region_id"
      ],
      "title": "CardEarth",
      "type": "object"
    },
    "CardInterpretation": {
      "additionalProperties": false,
      "description": "Question 2: the task the candidate could help investigate, always an assumption.",
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_label": {
          "const": "Assumed",
          "title": "Evidence Label",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence_label"
      ],
      "title": "CardInterpretation",
      "type": "object"
    },
    "CardStability": {
      "additionalProperties": false,
      "description": "Question 5: the uncertainty components and the ties of every family, kept separate.",
      "properties": {
        "uncertainty_components": {
          "$ref": "#/$defs/UncertaintyComponents"
        },
        "tied_by_family": {
          "$ref": "#/$defs/TiedByFamily"
        },
        "tie_group_by_family": {
          "$ref": "#/$defs/TieGroupByFamily"
        }
      },
      "required": [
        "uncertainty_components",
        "tied_by_family",
        "tie_group_by_family"
      ],
      "title": "CardStability",
      "type": "object"
    },
    "CardTarget": {
      "additionalProperties": false,
      "description": "The lunar or Mars window the card compares (question 1).",
      "properties": {
        "target_id": {
          "pattern": "^(moon|mars|earth)-[a-z0-9][a-z0-9-]*$",
          "title": "Target Id",
          "type": "string"
        },
        "target_window_id": {
          "pattern": "^(moon|mars|earth)-[a-z0-9][a-z0-9-]*$",
          "title": "Target Window Id",
          "type": "string"
        },
        "body": {
          "enum": [
            "moon",
            "mars",
            "earth"
          ],
          "title": "Body",
          "type": "string"
        },
        "polygon": {
          "$ref": "#/$defs/WindowPolygon"
        },
        "product_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Product Ids",
          "type": "array"
        }
      },
      "required": [
        "target_id",
        "target_window_id",
        "body",
        "polygon",
        "product_ids"
      ],
      "title": "CardTarget",
      "type": "object"
    },
    "ComparisonRef": {
      "additionalProperties": false,
      "description": "Where the card's ComparisonRecord is: comparisons/{target_id}.json.",
      "properties": {
        "path": {
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$",
          "title": "Path",
          "type": "string"
        },
        "target_window_id": {
          "pattern": "^(moon|mars|earth)-[a-z0-9][a-z0-9-]*$",
          "title": "Target Window Id",
          "type": "string"
        },
        "earth_window_id": {
          "pattern": "^(moon|mars|earth)-[a-z0-9][a-z0-9-]*$",
          "title": "Earth Window Id",
          "type": "string"
        }
      },
      "required": [
        "path",
        "target_window_id",
        "earth_window_id"
      ],
      "title": "ComparisonRef",
      "type": "object"
    },
    "DistanceEntry": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "value": {
                "type": "null"
              },
              "reason": {
                "type": "string"
              }
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              },
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "reference_spread_reason": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "reference_spread": {
                "type": "null"
              }
            },
            "required": [
              "reference_spread"
            ]
          },
          "then": {
            "properties": {
              "reference_spread_reason": {
                "type": "string"
              },
              "tied": {
                "type": "null"
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "background_percentile_reason": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "background_percentile": {
                "type": "null"
              }
            },
            "required": [
              "background_percentile"
            ]
          },
          "then": {
            "properties": {
              "background_percentile_reason": {
                "type": "string"
              }
            }
          }
        }
      ],
      "description": "One family's distance between a target and an Earth window (PRD 6.5).\n\n``value`` is set exactly when status is available, and ``reason`` exactly when it is not.\nA value of 0 is a real zero (identical fingerprints) and never stands for missing. Exactly\none of each spread and percentile pair is null, and ``tied`` is null without a spread.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "evidence_label": {
          "enum": [
            "Observed",
            "Derived",
            "Predicted",
            "Assumed",
            "Unavailable"
          ],
          "title": "Evidence Label",
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "unavailable",
            "not_comparable"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "reference_spread": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReferenceSpread"
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_spread_reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference Spread Reason"
        },
        "background_percentile": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Background Percentile"
        },
        "background_percentile_reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Background Percentile Reason"
        },
        "tied": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tied"
        },
        "tie_group": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tie Group"
        },
        "tie_reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tie Reason"
        }
      },
      "required": [
        "value",
        "unit",
        "evidence_label",
        "status",
        "reason",
        "reference_spread",
        "reference_spread_reason",
        "background_percentile",
        "background_percentile_reason",
        "tied",
        "tie_group",
        "tie_reason"
      ],
      "title": "DistanceEntry",
      "type": "object"
    },
    "DistancesByFamily": {
      "additionalProperties": false,
      "description": "The four family distances, every key always present (D07: never combined). In Python it\nreads as the read-only ``dict[Family, DistanceEntry]`` of CONTRACTS a.4.",
      "properties": {
        "terrain_relief": {
          "$ref": "#/$defs/DistanceEntry"
        },
        "terrain_texture": {
          "$ref": "#/$defs/DistanceEntry"
        },
        "radar_cpr": {
          "$ref": "#/$defs/DistanceEntry"
        },
        "model_embedding": {
          "$ref": "#/$defs/ModelEmbeddingDistanceEntry"
        }
      },
      "required": [
        "terrain_relief",
        "terrain_texture",
        "radar_cpr",
        "model_embedding"
      ],
      "title": "DistancesByFamily",
      "type": "object"
    },
    "FamilySpread": {
      "additionalProperties": false,
      "description": "The spread of one family's values across clones or within the window.",
      "properties": {
        "spread_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Spread Min"
        },
        "spread_median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Spread Median"
        },
        "spread_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Spread Max"
        },
        "n": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "N"
        }
      },
      "required": [
        "spread_min",
        "spread_median",
        "spread_max",
        "n"
      ],
      "title": "FamilySpread",
      "type": "object"
    },
    "FieldExperiment": {
      "additionalProperties": false,
      "description": "Question 7: the field observation that would test the candidate, always a proposal.",
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_label": {
          "const": "Assumed",
          "title": "Evidence Label",
          "type": "string"
        },
        "status": {
          "const": "proposed",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence_label",
        "status"
      ],
      "title": "FieldExperiment",
      "type": "object"
    },
    "FigureRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "path": {
                "type": "null"
              }
            },
            "required": [
              "path"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          }
        }
      ],
      "description": "A card figure A to C (PRD 10): its SVG path, or the reason it was not rendered.",
      "properties": {
        "figure": {
          "enum": [
            "A",
            "B",
            "C"
          ],
          "title": "Figure",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path"
        },
        "alt": {
          "minLength": 1,
          "title": "Alt",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        }
      },
      "required": [
        "figure",
        "path",
        "alt",
        "reason"
      ],
      "title": "FigureRef",
      "type": "object"
    },
    "ModelEmbeddingDistanceEntry": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "value": {
                "type": "null"
              },
              "reason": {
                "type": "string"
              }
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              },
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "reference_spread_reason": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "reference_spread": {
                "type": "null"
              }
            },
            "required": [
              "reference_spread"
            ]
          },
          "then": {
            "properties": {
              "reference_spread_reason": {
                "type": "string"
              },
              "tied": {
                "type": "null"
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "background_percentile_reason": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "background_percentile": {
                "type": "null"
              }
            },
            "required": [
              "background_percentile"
            ]
          },
          "then": {
            "properties": {
              "background_percentile_reason": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_label": {
                "const": "Predicted",
                "type": "string"
              }
            }
          }
        }
      ],
      "description": "The model_embedding distance: a value is a model prediction, so it is labelled\nPredicted.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "evidence_label": {
          "enum": [
            "Observed",
            "Derived",
            "Predicted",
            "Assumed",
            "Unavailable"
          ],
          "title": "Evidence Label",
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "unavailable",
            "not_comparable"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "reference_spread": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReferenceSpread"
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_spread_reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference Spread Reason"
        },
        "background_percentile": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Background Percentile"
        },
        "background_percentile_reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Background Percentile Reason"
        },
        "tied": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tied"
        },
        "tie_group": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tie Group"
        },
        "tie_reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tie Reason"
        }
      },
      "required": [
        "value",
        "unit",
        "evidence_label",
        "status",
        "reason",
        "reference_spread",
        "reference_spread_reason",
        "background_percentile",
        "background_percentile_reason",
        "tied",
        "tie_group",
        "tie_reason"
      ],
      "title": "ModelEmbeddingDistanceEntry",
      "type": "object"
    },
    "RadarContextEntry": {
      "additionalProperties": false,
      "description": "An observed radar statistic shown next to the card with its band (PRD 4 Mode B).",
      "properties": {
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "band": {
          "minLength": 1,
          "title": "Band",
          "type": "string"
        },
        "observable": {
          "minLength": 1,
          "title": "Observable",
          "type": "string"
        },
        "statistic": {
          "minLength": 1,
          "title": "Statistic",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "evidence_label": {
          "enum": [
            "Observed",
            "Derived",
            "Predicted",
            "Assumed",
            "Unavailable"
          ],
          "title": "Evidence Label",
          "type": "string"
        },
        "support_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Support M"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        }
      },
      "required": [
        "product_id",
        "band",
        "observable",
        "statistic",
