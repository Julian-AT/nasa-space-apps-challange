  "additionalProperties": false,
  "description": "An evidence card, cards/{card_id}.json (PRD 10).\n\nThe card carries no ``bundle_version``: the page shows the manifest's (D08). Gate states on\nthe page come from validation.json; ``g5_status`` is the state the card was built under. The\ndistances are the comparison's, unchanged, and question 5 repeats their ties. A Mode B or C\ncard has no radar distance (PRD 4).",
  "properties": {
    "card_id": {
      "pattern": "^(moon|mars|earth)-[a-z0-9][a-z0-9-]*__(moon|mars|earth)-[a-z0-9][a-z0-9-]*$",
      "title": "Card Id",
      "type": "string"
    },
    "mock": {
      "title": "Mock",
      "type": "boolean"
    },
    "run_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Run Id",
      "type": "string"
    },
    "shipping_mode": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "title": "Shipping Mode",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "wording": {
      "pattern": "^(candidate window identified by this search|Pilot pairing \\(G0-05\\); not shortlisted( \\(relief rank [0-9]+ of [0-9]+\\))?)$",
      "title": "Wording",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/CardTarget"
    },
    "earth": {
      "$ref": "#/$defs/CardEarth"
    },
    "comparison_ref": {
      "$ref": "#/$defs/ComparisonRef"
    },
    "q1_compared": {
      "minLength": 1,
      "title": "Q1 Compared",
      "type": "string"
    },
    "q2_interpretation": {
      "$ref": "#/$defs/CardInterpretation"
    },
    "q3_measurements": {
      "items": {
        "$ref": "#/$defs/TableDRow"
      },
      "title": "Q3 Measurements",
      "type": "array"
    },
    "q4_differences": {
      "$ref": "#/$defs/CardDifferences"
    },
    "q5_stability": {
      "$ref": "#/$defs/CardStability"
    },
    "q6_campaign": {
      "$ref": "#/$defs/CardCampaign"
    },
    "q7_field_experiment": {
      "$ref": "#/$defs/FieldExperiment"
    },
    "distances_by_family": {
      "$ref": "#/$defs/DistancesByFamily"
    },
    "radar_context": {
      "items": {
        "$ref": "#/$defs/RadarContextEntry"
      },
      "title": "Radar Context",
      "type": "array"
    },
    "figures": {
      "items": {
        "$ref": "#/$defs/FigureRef"
      },
      "title": "Figures",
      "type": "array"
    },
    "g5_status": {
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL",
        "PARTIAL",
        "NOT_APPLICABLE"
      ],
      "title": "G5 Status",
      "type": "string"
    },
    "claim_limits": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Claim Limits",
      "type": "array"
    }
  },
  "required": [
    "card_id",
    "mock",
    "run_id",
    "shipping_mode",
    "title",
    "wording",
    "target",
    "earth",
    "comparison_ref",
    "q1_compared",
    "q2_interpretation",
    "q3_measurements",
    "q4_differences",
    "q5_stability",
    "q6_campaign",
    "q7_field_experiment",
    "distances_by_family",
    "radar_context",
