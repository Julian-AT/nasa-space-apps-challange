{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A product read, or attempted, by the pipeline (PRD 8.12); sources.json lists them.\n\nEvery field must be present. A field that applies to the product but was not established\nfrom it is the string ``\"unknown\"``. ``null`` marks a field that does not apply, such as the\nradar frequency of a DEM, and is how the formatted fields (``source_url``, ``local_path`` and\n``checksum``) say that there is no URL or no downloaded file. A value is never ``\"\"`` or 0.\n\nFree-text fields hold what the product or its documentation states, keeping its wording and\nunits. ``checksum`` is the SHA-256 of the file at ``local_path``.",
  "if": {
    "properties": {
      "verification_status": {
        "const": "VERIFIED"
      }
    },
    "required": [
      "verification_status"
    ]
  },
  "properties": {
    "product_id": {
      "minLength": 1,
      "title": "Product Id",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "source_url": {
      "anyOf": [
        {
          "not": {
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[!$%&'()*+,.0-9:;=@A-Z\\[\\]_a-z~-]*@|[?#][!#$%&'()*+,./0-9:;=?@A-Z\\[\\]_a-z~-]*([Ss][Ii][Gg][Nn][Aa][Tt][Uu][Rr][Ee](=|%3[Dd])|[Ss][Ii][Gg](=|%3[Dd])|[Tt][Oo][Kk][Ee][Nn](=|%3[Dd])|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll](=|%3[Dd])|[Aa][Cc][Cc][Ee][Ss][Ss]_[Kk][Ee][Yy]|[Aa][Cc][Cc][Ee][Ss][Ss][Kk][Ee][Yy]|[Aa][Pp][Ii]_[Kk][Ee][Yy]|[Aa][Pp][Ii][Kk][Ee][Yy]|[Ee][Xx][Pp][Ii][Rr][Ee][Ss](=|%3[Dd])|[Kk][Ee][Yy]-[Pp][Aa][Ii][Rr]-[Ii][Dd](=|%3[Dd])|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt])|[?#][!#$%&'()*+,./0-9:;=?@A-Z\\[\\]_a-z~-]*%(2[DEde]|3[0-9]|[46][1-9A-Fa-f]|[57][0-9Aa]|5[Ff]|7[Ee])"
          },
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[!#$%&'()*+,./0-9:;=?@A-Z\\[\\]_a-z~-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Url"
    },
    "local_path": {
      "anyOf": [
        {
          "pattern": "^data/(raw|interim|processed)/[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Local Path"
    },
    "checksum": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Checksum"
    },
    "body": {
      "enum": [
        "moon",
        "mars",
        "earth"
      ],
      "title": "Body",
      "type": "string"
    },
    "acquisition_time": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Acquisition Time"
    },
    "frequency_or_wavelength": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Frequency Or Wavelength"
    },
    "transmit_receive_convention": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Transmit Receive Convention"
    },
    "units": {
      "minLength": 1,
      "title": "Units",
      "type": "string"
    },
    "calibration_type": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Calibration Type"
    },
    "native_grid": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Native Grid"
    },
    "effective_resolution": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Effective Resolution"
    },
    "crs_and_frame": {
      "minLength": 1,
      "title": "Crs And Frame",
      "type": "string"
    },
    "incidence_source": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Incidence Source"
    },
    "qa_definition": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Qa Definition"
    },
    "license_or_attribution": {
      "minLength": 1,
      "title": "License Or Attribution",
      "type": "string"
    },
    "verification_status": {
      "enum": [
        "NOT_CHECKED",
        "VERIFIED",
        "PARTIAL",
        "BLOCKED",
        "FAILED"
      ],
      "title": "Verification Status",
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "provider",
    "version",
    "source_url",
    "local_path",
    "checksum",
    "body",
    "acquisition_time",
    "frequency_or_wavelength",
    "transmit_receive_convention",
    "units",
    "calibration_type",
    "native_grid",
    "effective_resolution",
    "crs_and_frame",
    "incidence_source",
    "qa_definition",
    "license_or_attribution",
    "verification_status"
  ],
  "then": {
    "properties": {
      "local_path": {
        "type": "string"
      },
      "checksum": {
        "type": "string"
      },
      "units": {
        "not": {
          "pattern": "^[Uu][Nn][Kk][Nn][Oo][Ww][Nn]$"
        }
      }
    }
  },
  "title": "ProductRecord",
  "type": "object"
}
