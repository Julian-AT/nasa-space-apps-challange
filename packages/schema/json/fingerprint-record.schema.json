{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Distribution": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "values": {
                "items": {
                  "type": "number"
                },
                "minItems": 1,
                "type": "array"
              },
              "min": {
                "type": "number"
              },
              "median": {
                "type": "number"
              },
              "p05": {
                "type": "number"
              },
              "p95": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          },
          "if": {
            "properties": {
              "n": {
                "const": 0
              }
            },
            "required": [
              "n"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "items": {
                  "type": "number"
                },
                "maxItems": 0,
                "type": "array"
              },
              "min": {
                "type": "null"
              },
              "median": {
                "type": "null"
              },
              "p05": {
                "type": "null"
              },
              "p95": {
                "type": "null"
              },
              "max": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "Block values of one observable in one window, sorted ascending, and their order\nstatistics. ``n`` counts the values; the five statistics are null exactly when n is 0.",
      "properties": {
        "n": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "title": "Values",
          "type": "array"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Min"
        },
        "median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median"
        },
        "p05": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P05"
        },
        "p95": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P95"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max"
        }
      },
      "required": [
        "n",
        "values",
        "min",
        "median",
        "p05",
        "p95",
        "max"
      ],
      "title": "Distribution",
      "type": "object"
    },
    "IncidenceRange": {
      "additionalProperties": false,
      "description": "The incidence angles of the radar product over the window, in degrees. ``min`` does\nnot exceed ``max``; one angle has min equal to max.",
      "properties": {
        "min": {
          "title": "Min",
          "type": "number"
        },
        "max": {
          "title": "Max",
          "type": "number"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "title": "IncidenceRange",
      "type": "object"
    },
    "RadarFingerprint": {
      "additionalProperties": false,
      "description": "Radar block statistics of one product over a window (PRD 6.2). Blocks are never\nindependent samples, and CPR is aggregated as a ratio of mean powers.",
      "properties": {
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "band": {
          "minLength": 1,
          "title": "Band",
          "type": "string"
        },
        "frequency_or_wavelength": {
          "minLength": 1,
          "title": "Frequency Or Wavelength",
          "type": "string"
        },
        "convention": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Convention"
        },
        "support_m": {
          "exclusiveMinimum": 0,
          "title": "Support M",
          "type": "number"
        },
        "aggregation": {
          "const": "ratio_of_mean_powers",
          "title": "Aggregation",
          "type": "string"
        },
        "blocks_independent": {
          "const": false,
          "title": "Blocks Independent",
          "type": "boolean"
        },
        "n_blocks": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "N Blocks",
          "type": "integer"
        },
        "n_valid": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "N Valid",
          "type": "integer"
        },
        "valid_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Valid Fraction",
          "type": "number"
        },
        "cpr_ratio_of_mean_powers": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "cpr_mean_of_pixelwise_ratios": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "sc": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "oc": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "total_power": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "incidence_deg": {
          "anyOf": [
            {
              "$ref": "#/$defs/IncidenceRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "handedness_ratio": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        }
      },
      "required": [
        "product_id",
        "band",
        "frequency_or_wavelength",
        "convention",
        "support_m",
        "aggregation",
        "blocks_independent",
        "n_blocks",
        "n_valid",
        "valid_fraction",
        "cpr_ratio_of_mean_powers",
        "cpr_mean_of_pixelwise_ratios",
        "sc",
        "oc",
        "total_power",
        "incidence_deg",
        "handedness_ratio",
        "reason"
      ],
      "title": "RadarFingerprint",
      "type": "object"
    },
    "TerrainFingerprint": {
      "additionalProperties": false,
      "description": "Terrain observables of a window on the analysis grid (PRD 6.3, D29 resampler).",
      "properties": {
        "analysis_grid_m": {
          "exclusiveMinimum": 0,
          "title": "Analysis Grid M",
          "type": "number"
        },
        "coarsening_factor": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Coarsening Factor"
        },
        "resampler": {
          "const": "aeqd_sphere",
          "title": "Resampler",
          "type": "string"
        },
        "valid_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Valid Fraction",
          "type": "number"
        },
        "relief": {
          "$ref": "#/$defs/TerrainVariant"
        },
        "texture": {
          "$ref": "#/$defs/TerrainVariant"
        }
      },
      "required": [
        "analysis_grid_m",
        "coarsening_factor",
        "resampler",
        "valid_fraction",
        "relief",
        "texture"
      ],
      "title": "TerrainFingerprint",
      "type": "object"
    },
    "TerrainVariant": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "hurst_reason": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "hurst": {
                "type": "null"
              }
            },
            "required": [
              "hurst"
            ]
          },
          "then": {
            "properties": {
              "hurst_reason": {
                "type": "string"
              }
            }
          }
        }
      ],
      "description": "nu over the window's lags for one variant: relief (raw) or texture (plane removed).\n\n``nu_m`` keys are lags in metres as T3 writes them. Exactly one of ``hurst`` and\n``hurst_reason`` is null. ``tilt`` holds the fitted plane coefficients (texture only).",
      "properties": {
        "detrend": {
          "enum": [
            "none",
            "plane"
          ],
          "title": "Detrend",
          "type": "string"
        },
        "supported_lags_m": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "title": "Supported Lags M",
          "type": "array"
        },
        "unsupported_lags": {
          "items": {
            "$ref": "#/$defs/UnsupportedLag"
          },
          "title": "Unsupported Lags",
          "type": "array"
        },
        "nu_m": {
          "additionalProperties": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Nu M",
          "type": "object"
        },
        "nu_by_direction_m": {
          "additionalProperties": {
            "additionalProperties": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "propertyNames": {
              "minLength": 1
            },
            "type": "object"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Nu By Direction M",
          "type": "object"
        },
        "hurst": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hurst"
        },
        "hurst_reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hurst Reason"
        },
        "tilt": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tilt"
        }
      },
      "required": [
        "detrend",
        "supported_lags_m",
        "unsupported_lags",
        "nu_m",
        "nu_by_direction_m",
        "hurst",
        "hurst_reason",
        "tilt"
      ],
      "title": "TerrainVariant",
      "type": "object"
    },
    "UnsupportedLag": {
      "additionalProperties": false,
      "description": "A lag that is not supported in this window, with the reason.",
      "properties": {
        "lag_m": {
          "exclusiveMinimum": 0,
          "title": "Lag M",
          "type": "number"
        },
        "reason": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "lag_m",
        "reason"
      ],
      "title": "UnsupportedLag",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "terrain"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "radar": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "radar"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "terrain": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terrain": {
            "type": "null"
          }
        },
        "required": [
          "terrain"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "radar",
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "radar": {
            "type": "null"
          }
        },
        "required": [
          "radar"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "terrain",
            "type": "string"
          }
        }
      }
    }
  ],
  "description": "The terrain or radar fingerprint of a window: ``terrain`` is set exactly when kind is\nterrain and ``radar`` exactly when kind is radar.",
  "properties": {
    "window_id": {
      "pattern": "^(moon|mars|earth)-[a-z0-9][a-z0-9-]*$",
      "title": "Window Id",
      "type": "string"
    },
    "body": {
      "enum": [
        "moon",
        "mars",
        "earth"
      ],
      "title": "Body",
      "type": "string"
    },
    "kind": {
      "enum": [
        "terrain",
        "radar"
      ],
      "title": "Kind",
      "type": "string"
    },
    "product_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Product Ids",
      "type": "array"
    },
    "evidence_label": {
      "enum": [
        "Observed",
        "Derived",
        "Predicted",
        "Assumed",
        "Unavailable"
      ],
      "title": "Evidence Label",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "run_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Run Id",
      "type": "string"
    },
    "terrain": {
      "anyOf": [
        {
          "$ref": "#/$defs/TerrainFingerprint"
        },
        {
          "type": "null"
        }
      ]
    },
    "radar": {
      "anyOf": [
        {
          "$ref": "#/$defs/RadarFingerprint"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "window_id",
    "body",
    "kind",
    "product_ids",
    "evidence_label",
    "input_hash",
    "run_id",
    "terrain",
    "radar"
  ],
  "title": "FingerprintRecord",
  "type": "object"
}
