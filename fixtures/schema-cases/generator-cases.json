          "slug": "ok"
        }
      },
      {
        "name": "status-null",
        "valid": false,
        "value": {
          "status": null,
          "label": "a",
          "code": "c1",
          "slug": "ok"
        }
      },
      {
        "name": "status-lowercase",
        "valid": false,
        "value": {
