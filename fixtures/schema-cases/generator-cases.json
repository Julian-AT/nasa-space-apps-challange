[
  {
    "name": "conditional",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Conditional",
      "description": "Synthetic: when status is DONE, label must be a string and code must not be all x.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "DONE",
            "OPEN"
          ]
        },
        "label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z]+$",
          "not": {
            "pattern": "bad"
          }
        }
      },
      "required": [
        "status",
        "label",
        "code",
        "slug"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "status": {
            "const": "DONE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "label": {
            "type": "string"
          },
          "code": {
            "not": {
              "pattern": "^[Xx]+$"
            }
          }
        }
      }
    },
    "cases": [
      {
        "name": "done-complete",
        "valid": true,
        "value": {
          "status": "DONE",
          "label": "a",
          "code": "c1",
          "slug": "ok"
        }
      },
      {
        "name": "open-complete",
        "valid": true,
        "value": {
          "status": "OPEN",
          "label": "a",
          "code": "c1",
          "slug": "ok"
        }
      },
      {
        "name": "done-label-null",
        "valid": false,
        "value": {
          "status": "DONE",
          "label": null,
          "code": "c1",
          "slug": "ok"
        }
      },
      {
        "name": "open-label-null",
        "valid": true,
        "value": {
          "status": "OPEN",
          "label": null,
          "code": "c1",
          "slug": "ok"
        }
      },
      {
