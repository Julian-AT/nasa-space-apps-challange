          "code": "x",
          "slug": "ok"
        }
      },
      {
        "name": "done-code-mixed-case-x",
        "valid": false,
        "value": {
          "status": "DONE",
          "label": "a",
          "code": "xXx",
          "slug": "ok"
        }
      },
      {
        "name": "open-code-x",
        "valid": true,
        "value": {
          "status": "OPEN",
          "label": "a",
          "code": "xx",
          "slug": "ok"
