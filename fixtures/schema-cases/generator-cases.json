  },
  {
    "name": "conditional-two-keys",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ConditionalTwoKeys",
      "description": "Synthetic: when status is DONE and kind is A, label must be a string.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "DONE",
            "OPEN"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "A",
            "B"
          ]
        },
        "label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
