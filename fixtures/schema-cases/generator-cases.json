      },
      "required": [
        "status",
        "kind",
        "label"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "status": {
            "const": "DONE"
          },
          "kind": {
            "const": "A"
          }
        },
        "required": [
          "status",
          "kind"
        ]
      },
      "then": {
        "properties": {
          "label": {
            "type": "string"
          }
        }
      }
    },
    "cases": [
