# Terraluna build entry point (PRD 12, Commands). Recipes are POSIX sh for GNU Make 3.81.

SHELL := /bin/sh
.SUFFIXES:

UV ?= uv
UV_RUN := $(UV) run --locked
EXPORT := $(UV_RUN) python -m terraluna_pipeline.export
SCHEMA := $(UV_RUN) python -m terraluna_pipeline.schema
SCHEMA_JSON := packages/schema/json

NODE ?= node
PNPM ?= pnpm
# Turborepo runs the package scripts with its local cache; telemetry stays off (PRD 8.9), also for
# the Next.js CLI that the web typecheck runs.
TURBO := TURBO_TELEMETRY_DISABLED=1 NEXT_TELEMETRY_DISABLED=1 $(PNPM) exec turbo --no-update-notifier
ZOD := $(NODE) packages/schema/scripts/generate-zod.ts
ZOD_OUT := packages/schema/src/generated
# @terraluna/web scripts; Next.js telemetry stays off like Turborepo's.
WEB := NEXT_TELEMETRY_DISABLED=1 $(PNPM) --filter @terraluna/web

.PHONY: setup check test setup-py check-py test-py setup-ts check-ts test-ts schema schema-check \
	mock-bundle mock-bundle-check web-build web-smoke web-dev

setup: setup-py setup-ts
check: check-py check-ts
test: test-py test-ts

# uv sync on the virtual workspace root installs both members and the dev group from uv.lock.
setup-py:
	$(UV) sync --locked
	@$(UV_RUN) python -c 'import sys; v = sys.version_info; print(f"Python {v.major}.{v.minor}.{v.micro}"); sys.exit(None if v[:2] == (3, 12) else "setup-py: Python 3.12 is required")'
	@$(UV_RUN) python -c 'import rasterio; print(f"GDAL {rasterio.__gdal_version__} (rasterio {rasterio.__version__})")' \
		|| { echo "setup-py: rasterio cannot be imported, so GDAL is unavailable" >&2; exit 1; }

check-py:
	$(UV_RUN) ruff check
	$(UV_RUN) ruff format --check
	$(UV_RUN) mypy

test-py:
	$(UV_RUN) pytest

# Node 22 (PRD 8.2) at 22.18 or later: it is the first 22.x that strips types by default, so
# $(ZOD) and the generator tests run the .ts script without a flag (Vitest 5 itself needs 22.12).
# Then the exact pnpm lockfile. The root prepare script installs the husky commit-msg hook.
NODE_MIN_MINOR := 18

setup-ts:
	@v=$$($(NODE) -p 'process.versions.node') || { echo "setup-ts: node cannot be run" >&2; exit 1; }; \
	case "$$v" in 22.*) minor=$${v#22.}; minor=$${minor%%.*} ;; *) minor= ;; esac; \
	case "$$minor" in '' | *[!0-9]*) minor=-1 ;; esac; \
	if [ "$$minor" -ge $(NODE_MIN_MINOR) ]; then echo "Node $$v"; else \
		echo "setup-ts: Node 22.$(NODE_MIN_MINOR) or a later 22.x is required, found $$v" >&2; exit 1; fi
	$(PNPM) install --frozen-lockfile

check-ts:
	$(TURBO) run lint typecheck

test-ts:
	$(TURBO) run test

# JSON Schema 2020-12 generated from pipeline/src/terraluna_pipeline/schema.py, then zod generated
# from that JSON Schema by packages/schema/scripts/generate-zod.ts; both are committed (PRD 8.3,
# 8.9). schema overwrites the generated files in place and deletes nothing.
schema:
	$(SCHEMA) write $(SCHEMA_JSON)
	$(ZOD) write $(SCHEMA_JSON) $(ZOD_OUT)

# Regenerates both outputs without writing to the repository and prints a diff for each committed
# file that differs. Both checks always run; the target fails if either finds drift.
schema-check:
	@status=0; \
	$(SCHEMA) check $(SCHEMA_JSON) || status=1; \
	$(ZOD) check $(SCHEMA_JSON) $(ZOD_OUT) || status=1; \
	exit $$status

# The labelled mock bundle (PRD 8.4) is generated by export.py and committed. mock-bundle
# overwrites only the mock bundle's own files and refuses a directory holding anything else.
mock-bundle:
	$(EXPORT) mock-bundle fixtures/mock-bundle

# Regenerates into a temporary directory, prints a diff and fails if the committed copy differs,
# then validates the committed copy.
mock-bundle-check:
	$(EXPORT) mock-bundle-check fixtures/mock-bundle

# The web app on the bundle that BUNDLE_VERSION selects: fixtures/mock-bundle when it is unset or
# empty, otherwise release/$(BUNDLE_VERSION)/ (PRD 8.5, 8.9). bundle:pull validates manifest.json
# and validation.json and copies them into apps/web/data/; it and next build both refuse a mock
# bundle when VERCEL_ENV=production.
web-build:
	$(WEB) bundle:pull
	$(WEB) build

# Builds, starts next start on a free port, checks / and always stops the server.
web-smoke: web-build
	$(WEB) smoke

web-dev:
	$(WEB) bundle:pull
	$(WEB) dev

# t4-logic T4L-08
# The real release bundle (CONTRACTS c.1): stage every bundle path, then assemble release/<v>/.
# BUNDLE_UTC defaults to the current UTC minute and BUNDLE_SHA to the short HEAD; override both
# to rebuild a version, e.g. make bundle BUNDLE_UTC=2026-11-15T0900Z BUNDLE_SHA=3f9c2a1.
BUNDLE_UTC ?= $(shell date -u +%Y-%m-%dT%H%MZ)
BUNDLE_SHA ?= $(shell git rev-parse --short=7 HEAD)
BUNDLE_STAGING ?= data/processed/bundle-staging
RELEASE_DIR ?= release
.PHONY: bundle
bundle:
	$(EXPORT) stage --out $(BUNDLE_STAGING)
	v=$$($(EXPORT) bundle-version --utc $(BUNDLE_UTC) --sha $(BUNDLE_SHA)) && \
	$(EXPORT) assemble --staging $(BUNDLE_STAGING) --bundle-version "$$v" --release-dir $(RELEASE_DIR)

# --- fast/uncert block (T6): uncertainty, G3/G4 checks and Appendix A records ----------------
# uncert-refresh rewrites the comparisons, cards, figures and the G4 record from the committed
# clone and G4 inputs (needs the data/processed caches); rerun it whenever the comparisons are
# regenerated. uncert-verify is offline and writes nothing.
.PHONY: uncert-refresh uncert-verify
uncert-refresh:
	uv run python -m terraluna_pipeline.checks g4
	uv run python -m terraluna_pipeline.uncertainty annotate
	uv run python -m terraluna_pipeline.export cards
	uv run python -m terraluna_pipeline.export cards --target-window moon-sps-x2-y2 --earth-window earth-utm27n-e280-n2880
	uv run python -m terraluna_pipeline.figures cards
	uv run python -m terraluna_pipeline.checks g4

uncert-verify:
	uv run python -m terraluna_pipeline.uncertainty verify
	uv run python -m terraluna_pipeline.checks verify-records
	uv run python -m terraluna_pipeline.gates verify
	uv run python -m terraluna_pipeline.holuhraun check
	uv run python -m terraluna_pipeline.lunar_context check

# --- fast/search block (T5): candidate search, run where the raw products live (the compute
# server). compute writes outputs/search/* and the git-ignored data/processed/{windows,search,tiles}.
SEARCH := $(UV_RUN) python -m terraluna_pipeline.search
.PHONY: search search-verify
search:
	$(SEARCH) compute --raw-root "$${TERRALUNA_RAW:?set TERRALUNA_RAW to the raw product root}"
search-verify:
	$(SEARCH) verify outputs/search
