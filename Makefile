# Terraluna build entry point (PRD 12, Commands). Recipes are POSIX sh for GNU Make 3.81.

SHELL := /bin/sh
.SUFFIXES:

UV ?= uv
UV_RUN := $(UV) run --locked
EXPORT := $(UV_RUN) python -m terraluna_pipeline.export
SCHEMA := $(UV_RUN) python -m terraluna_pipeline.schema
SCHEMA_JSON := packages/schema/json

NODE ?= node
PNPM ?= pnpm
# Turborepo runs the package scripts with its local cache; telemetry stays off (PRD 8.9).
TURBO := TURBO_TELEMETRY_DISABLED=1 $(PNPM) exec turbo --no-update-notifier
ZOD := $(NODE) packages/schema/scripts/generate-zod.ts
ZOD_OUT := packages/schema/src/generated

.PHONY: setup check test setup-py check-py test-py setup-ts check-ts test-ts schema schema-check \
	mock-bundle mock-bundle-check

setup: setup-py setup-ts
check: check-py check-ts
test: test-py test-ts

# uv sync on the virtual workspace root installs both members and the dev group from uv.lock.
setup-py:
	$(UV) sync --locked
	@$(UV_RUN) python -c 'import sys; v = sys.version_info; print(f"Python {v.major}.{v.minor}.{v.micro}"); sys.exit(None if v[:2] == (3, 12) else "setup-py: Python 3.12 is required")'
	@$(UV_RUN) python -c 'import rasterio; print(f"GDAL {rasterio.__gdal_version__} (rasterio {rasterio.__version__})")' \
		|| { echo "setup-py: rasterio cannot be imported, so GDAL is unavailable" >&2; exit 1; }

check-py:
	$(UV_RUN) ruff check
	$(UV_RUN) ruff format --check
	$(UV_RUN) mypy

test-py:
	$(UV_RUN) pytest

# Node 22 (PRD 8.2), then the exact pnpm lockfile. The root prepare script installs the husky
# commit-msg hook.
setup-ts:
	@v=$$($(NODE) -p 'process.versions.node') || { echo "setup-ts: node cannot be run" >&2; exit 1; }; \
	case "$$v" in \
		22.*) echo "Node $$v" ;; \
		*) echo "setup-ts: Node 22 is required, found $$v" >&2; exit 1 ;; \
	esac
	$(PNPM) install --frozen-lockfile

check-ts:
	$(TURBO) run lint typecheck

test-ts:
	$(TURBO) run test

# JSON Schema 2020-12 generated from pipeline/src/terraluna_pipeline/schema.py, then zod generated
# from that JSON Schema by packages/schema/scripts/generate-zod.ts; both are committed (PRD 8.3,
# 8.9). schema overwrites the generated files in place and deletes nothing.
schema:
	$(SCHEMA) write $(SCHEMA_JSON)
	$(ZOD) write $(SCHEMA_JSON) $(ZOD_OUT)

# Regenerates both outputs without writing to the repository and prints a diff for each committed
# file that differs. Both checks always run; the target fails if either finds drift.
schema-check:
	@status=0; \
	$(SCHEMA) check $(SCHEMA_JSON) || status=1; \
	$(ZOD) check $(SCHEMA_JSON) $(ZOD_OUT) || status=1; \
	exit $$status

# The labelled mock bundle (PRD 8.4) is generated by export.py and committed. mock-bundle
# overwrites only the mock bundle's own files and refuses a directory holding anything else.
mock-bundle:
	$(EXPORT) mock-bundle fixtures/mock-bundle

# Regenerates into a temporary directory, prints a diff and fails if the committed copy differs,
# then validates the committed copy.
mock-bundle-check:
	$(EXPORT) mock-bundle-check fixtures/mock-bundle
